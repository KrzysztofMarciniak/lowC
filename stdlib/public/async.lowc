struct AsyncPollFd {
        s4 descriptor;
        s2 events;
        s2 returned_events;
};

foreign c s4 poll(
        struct AsyncPollFd* descriptors,
        u8 count,
        s4 timeout_ms
);
foreign c s4* __errno_location(void);

s4, s4 async_poll(
        struct AsyncPollFd* descriptors,
        u8 count,
        s4 timeout_ms
) {
        s4 ready_count = 0;

        if (timeout_ms < -1) {
                return 0, -22;
        }

        ready_count = poll(descriptors, count, timeout_ms);
        if (ready_count < 0) {
                return 0, -(*__errno_location());
        }

        return ready_count, 0;
}

s2 async_event_readable(void) {
        return 1;
}

s2 async_event_priority(void) {
        return 2;
}

s2 async_event_writable(void) {
        return 4;
}

s2 async_event_error(void) {
        return 8;
}

s2 async_event_hangup(void) {
        return 16;
}

s2 async_event_invalid(void) {
        return 32;
}
