s8 list_s8_remove(struct ListS8* list, u8 index, s8* value) {
        u8 cursor = 0;
        struct ListS8Node* previous = 0;
        struct ListS8Node* node = 0;
        struct ListS8Node* next = 0;
        s8 result = 0;

        if (index >= list->size) {
                return -34;
        }
        node = list->head;
        for (cursor = 0; cursor < index; cursor = cursor + 1) {
                previous = node;
                node = node->next;
        }
        *value = node->value;
        next = node->next;
        if (index == 0) {
                list->head = next;
        } else {
                previous->next = next;
        }
        if (index + 1 == list->size) {
                list->tail = previous;
        }
        result = __lowc_collections_free(node);
        if (result < 0) {
                if (index == 0) {
                        list->head = node;
                } else {
                        previous->next = node;
                }
                node->next = next;
                if (index + 1 == list->size || list->size == 1) {
                        list->tail = node;
                }
                return result;
        }
        list->size = list->size - 1;
        return 0;
}

s8 list_s8_deinit(struct ListS8* list) {
        struct ListS8Node* empty = 0;
        struct ListS8Node* node = 0;
        struct ListS8Node* next = 0;
        s8 result = 0;

        node = list->head;
        for (; list->size != 0;) {
                next = node->next;
                result = __lowc_collections_free(node);
                if (result < 0) {
                        list->head = node;
                        return result;
                }
                list->head = next;
                list->size = list->size - 1;
                node = next;
        }
        list->tail = empty;
        list->size = 0;
        return 0;
}
