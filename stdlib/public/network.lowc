import ../internal/network/main.lowc : __lowc_tcp_connect, __lowc_tcp_send, __lowc_tcp_receive,
    __lowc_tcp_close, __lowc_udp_connect, __lowc_udp_send, __lowc_udp_receive,
    __lowc_network_set_timeout;

struct TcpConnection {
    s4 descriptor;
};

struct UdpConnection {
    s4 descriptor;
};

s8 tcp_connect(u1 *host, u8 port, struct TcpConnection *connection) {
    s4 descriptor = 0;
    s8 result = 0;

    connection->descriptor = -1;
    result = __lowc_tcp_connect(host, port, &descriptor);
    if (result != 0) {
        return result;
    }

    connection->descriptor = descriptor;
    return 0;
}

s8 tcp_send(struct TcpConnection *connection, u1 *buffer, u8 length) {
    if (connection->descriptor < 0) {
        return -9;
    }

    return __lowc_tcp_send(connection->descriptor, buffer, length);
}

s8 tcp_receive(struct TcpConnection *connection, u1 *buffer, u8 length) {
    if (connection->descriptor < 0) {
        return -9;
    }

    return __lowc_tcp_receive(connection->descriptor, buffer, length);
}

s8 tcp_set_timeout(
    struct TcpConnection *connection,
    u8 receive_timeout_ms,
    u8 send_timeout_ms
) {
    if (connection->descriptor < 0) {
        return -9;
    }

    return __lowc_network_set_timeout(
        connection->descriptor,
        receive_timeout_ms,
        send_timeout_ms
    );
}

s8 tcp_close(struct TcpConnection *connection) {
    s8 result = 0;

    if (connection->descriptor < 0) {
        return -9;
    }

    result = __lowc_tcp_close(connection->descriptor);
    if (result == 0) {
        connection->descriptor = -1;
    }

    return result;
}

s8 udp_connect(u1 *host, u8 port, struct UdpConnection *connection) {
    s4 descriptor = 0;
    s8 result = 0;

    connection->descriptor = -1;
    result = __lowc_udp_connect(host, port, &descriptor);
    if (result != 0) {
        return result;
    }

    connection->descriptor = descriptor;
    return 0;
}

s8 udp_send(struct UdpConnection *connection, u1 *buffer, u8 length) {
    if (connection->descriptor < 0) {
        return -9;
    }

    return __lowc_udp_send(connection->descriptor, buffer, length);
}

s8 udp_receive(struct UdpConnection *connection, u1 *buffer, u8 length) {
    if (connection->descriptor < 0) {
        return -9;
    }

    return __lowc_udp_receive(connection->descriptor, buffer, length);
}

s8 udp_set_timeout(
    struct UdpConnection *connection,
    u8 receive_timeout_ms,
    u8 send_timeout_ms
) {
    if (connection->descriptor < 0) {
        return -9;
    }

    return __lowc_network_set_timeout(
        connection->descriptor,
        receive_timeout_ms,
        send_timeout_ms
    );
}

s8 udp_close(struct UdpConnection *connection) {
    s8 result = 0;

    if (connection->descriptor < 0) {
        return -9;
    }

    result = __lowc_tcp_close(connection->descriptor);
    if (result == 0) {
        connection->descriptor = -1;
    }

    return result;
}
