import ../internal/file/main.lowc : __lowc_file_open, __lowc_file_read, __lowc_file_write,
    __lowc_file_close;
import ../internal/os/main.lowc : __lowc_os_file_stat;

struct File {
    s8 descriptor;
};

struct FileMetadata {
    s8 size;
    u4 mode;
    u4 kind;
    s8 modified_seconds;
};

s8 file_metadata(u1 *path, struct FileMetadata *metadata) {
    s8 result = 0;
    u1 *null_path = 0;
    struct FileMetadata *null_metadata = 0;

    if (path == null_path || metadata == null_metadata) {
        return -22;
    }
    result = __lowc_os_file_stat(
        path,
        &metadata->size,
        &metadata->mode,
        &metadata->modified_seconds
    );
    if (result < 0) {
        return result;
    }
    metadata->kind = metadata->mode / 4096 % 16 * 4096;
    return 0;
}

u1, s8 file_exists(u1 *path) {
    struct FileMetadata metadata = 0;
    s8 result = 0;
    u1 *null_path = 0;

    if (path == null_path) {
        return 0, -22;
    }
    result = file_metadata(path, &metadata);
    if (result == -2 || result == -20) {
        return 0, 0;
    }
    if (result < 0) {
        return 0, result;
    }
    return 1, 0;
}

s8 file_open_read(u1 *path, struct File *file) {
    s8 descriptor = 0;
    s8 flags = 0;

    file->descriptor = -1;
    descriptor = __lowc_file_open(path, flags);
    if (descriptor < 0) {
        return descriptor;
    }

    file->descriptor = descriptor;
    return 0;
}

s8 file_open_write(u1 *path, struct File *file) {
    s8 descriptor = 0;
    s8 flags = 577;

    file->descriptor = -1;
    descriptor = __lowc_file_open(path, flags);
    if (descriptor < 0) {
        return descriptor;
    }

    file->descriptor = descriptor;
    return 0;
}

s8 file_open_append(u1 *path, struct File *file) {
    s8 descriptor = 0;
    s8 flags = 1089;

    file->descriptor = -1;
    descriptor = __lowc_file_open(path, flags);
    if (descriptor < 0) {
        return descriptor;
    }

    file->descriptor = descriptor;
    return 0;
}

s8 file_read(struct File *file, u1 *buffer, u8 length) {
    return __lowc_file_read(file->descriptor, buffer, length);
}

s8 file_write(struct File *file, u1 *buffer, u8 length) {
    return __lowc_file_write(file->descriptor, buffer, length);
}

s8 file_close(struct File *file) {
    s8 result = 0;

    if (file->descriptor < 0) {
        return -9;
    }

    result = __lowc_file_close(file->descriptor);
    if (result == 0) {
        file->descriptor = -1;
    }

    return result;
}
