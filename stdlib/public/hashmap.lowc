#include "memory.lowc" : "alloc", "dealloc";

struct HashMap {
        u8* keys;
        u8* values;
        u1* states;
        u8 capacity;
        u8 count;
};

u8 hashmap_index(u8 key, u8 capacity) {
        u8 index = 0;

        asm("xor rdx, rdx\ndiv %2\nmov %0, rdx"
            : "=rax"(index)
            : "rax"(key), "rsi"(capacity)
            : "rdx", "cc");

        return index;
}

void hashmap_place(struct HashMap* map, u8 key, u8 value) {
        u8 index         = 0;
        u8 probes        = 0;
        u8 first_deleted = 0;
        u1 found         = 0;

        index         = hashmap_index(key, map->capacity);
        probes        = 0;
        first_deleted = map->capacity;
        found         = 0;

        for (; probes < map->capacity && found == 0 && map->states[index] != 0;
             probes = probes + 1) {
                if (map->states[index] == 1 && map->keys[index] == key) {
                        found = 1;
                } else {
                        if (map->states[index] == 2 &&
                            first_deleted == map->capacity) {
                                first_deleted = index;
                        }
                        index = (index + 1) % map->capacity;
                }
        }

        if (found == 0 && first_deleted < map->capacity) {
                index = first_deleted;
        }

        if (map->states[index] != 1) {
                map->count = map->count + 1;
        }

        map->keys[index]   = key;
        map->values[index] = value;
        map->states[index] = 1;
}

void hashmap_resize(struct HashMap* map, u8 capacity) {
        u8* old_keys    = 0;
        u8* old_values  = 0;
        u1* old_states  = 0;
        u8 old_capacity = 0;
        u8 index        = 0;

        old_keys     = map->keys;
        old_values   = map->values;
        old_states   = map->states;
        old_capacity = map->capacity;

        map->capacity = capacity;
        map->count    = 0;
        map->keys     = alloc(capacity * 8);
        map->values   = alloc(capacity * 8);
        map->states   = alloc(capacity);

        for (index = 0; index < capacity; index = index + 1) {
                map->states[index] = 0;
        }

        for (index = 0; index < old_capacity; index = index + 1) {
                if (old_states[index] == 1) {
                        hashmap_place(map, old_keys[index], old_values[index]);
                }
        }

        dealloc(old_keys);
        dealloc(old_values);
        dealloc(old_states);
}

void hashmap_init(struct HashMap* map, u8 capacity) {
        u8 index = 0;

        if (capacity < 8) {
                capacity = 8;
        }

        map->capacity = capacity;
        map->count    = 0;
        map->keys     = alloc(capacity * 8);
        map->values   = alloc(capacity * 8);
        map->states   = alloc(capacity);

        for (index = 0; index < capacity; index = index + 1) {
                map->states[index] = 0;
        }
}

void hashmap_set(struct HashMap* map, u8 key, u8 value) {
        if ((map->count + 1) * 4 >= map->capacity * 3) {
                hashmap_resize(map, map->capacity * 2);
        }

        hashmap_place(map, key, value);
}

u1 hashmap_get(struct HashMap* map, u8 key, u8* value) {
        u8 index  = 0;
        u8 probes = 0;
        u1 found  = 0;

        index  = hashmap_index(key, map->capacity);
        probes = 0;
        found  = 0;

        for (; probes < map->capacity && found == 0 && map->states[index] != 0;
             probes = probes + 1) {
                if (map->states[index] == 1 && map->keys[index] == key) {
                        *value = map->values[index];
                        found  = 1;
                } else {
                        index = (index + 1) % map->capacity;
                }
        }

        return found;
}

u1 hashmap_remove(struct HashMap* map, u8 key) {
        u8 index  = 0;
        u8 probes = 0;
        u1 found  = 0;

        index  = hashmap_index(key, map->capacity);
        probes = 0;
        found  = 0;

        for (; probes < map->capacity && found == 0 && map->states[index] != 0;
             probes = probes + 1) {
                if (map->states[index] == 1 && map->keys[index] == key) {
                        map->states[index] = 2;
                        map->count         = map->count - 1;
                        found              = 1;
                } else {
                        index = (index + 1) % map->capacity;
                }
        }

        return found;
}

u1 hashmap_deinit(struct HashMap* map) {
        u1 keys_freed   = 0;
        u1 values_freed = 0;
        u1 states_freed = 0;

        keys_freed    = dealloc(map->keys);
        values_freed  = dealloc(map->values);
        states_freed  = dealloc(map->states);
        map->capacity = 0;
        map->count    = 0;

        return keys_freed && values_freed && states_freed;
}
