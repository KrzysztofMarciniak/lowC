u8 __lowc_args_argc   = 0;
u1** __lowc_args_argv = 0;

u8 args_count(void) { return __lowc_args_argc; }

u1, u1* args_get(u8 index) {
        u1* argument = 0;

        if (index >= __lowc_args_argc) {
                return 0, argument;
        }

        argument = __lowc_args_argv[index];
        return 1, argument;
}
