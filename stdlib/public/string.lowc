#include "../internal/string/main.lowc" : "__lowc_strlen";
#include "memory.lowc" : "alloc";

u64 strlen(u8 *data) {
    return __lowc_strlen(data);
}

u1 parse_u64(u8 *text, u64 *result) {
    u8 *maximum;
    u64 length;
    u64 first_significant;
    u64 significant_length;
    u64 index;
    u64 parsed;
    s64 comparison;

    maximum = "18446744073709551615";
    length = 0;

    for (; text[length] != 0; length = length + 1) {
        if (text[length] < 48 || text[length] > 57) {
            return 0;
        }
    }

    if (length == 0) {
        return 0;
    }

    first_significant = 0;
    for (
        ;
        first_significant < length && text[first_significant] == 48;
        first_significant = first_significant + 1
    ) {
    }

    significant_length = length - first_significant;
    if (significant_length > 20) {
        return 0;
    }

    if (significant_length == 20) {
        comparison = 0;

        for (index = 0; index < 20; index = index + 1) {
            if (comparison == 0) {
                if (text[first_significant + index] > maximum[index]) {
                    comparison = 1;
                }

                if (text[first_significant + index] < maximum[index]) {
                    comparison = -1;
                }
            }
        }

        if (comparison > 0) {
            return 0;
        }
    }

    parsed = 0;
    for (index = 0; index < length; index = index + 1) {
        parsed = parsed * 10 + (text[index] - 48);
    }

    *result = parsed;
    return 1;
}

s64 strcmp(u8 *left, u8 *right) {
    u64 index;

    for (
        index = 0;
        left[index] == right[index] && left[index] != 0;
        index = index + 1
    ) {
    }

    if (left[index] < right[index]) {
        return -1;
    }

    if (left[index] > right[index]) {
        return 1;
    }

    return 0;
}

u8 *strcpy(u8 *destination, u8 *source) {
    u8 *result;
    u64 index;

    result = destination;

    for (index = 0; source[index] != 0; index = index + 1) {
        destination[index] = source[index];
    }

    destination[index] = 0;
    return result;
}

u8 *strcat(u8 *destination, u8 *source) {
    u8 *result;
    u64 destination_length;
    u64 source_index;

    result = destination;

    for (
        destination_length = 0;
        destination[destination_length] != 0;
        destination_length = destination_length + 1
    ) {
    }

    for (source_index = 0; source[source_index] != 0; source_index = source_index + 1) {
        destination[destination_length + source_index] =
            source[source_index];
    }

    destination[destination_length + source_index] = 0;
    return result;
}

u8 *strdup(u8 *source) {
    u8 *result;
    u64 length;
    u64 index;

    length = strlen(source);
    result = alloc(length + 1);

    for (index = 0; index <= length; index = index + 1) {
        result[index] = source[index];
    }

    return result;
}
