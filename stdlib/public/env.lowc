foreign c u1 *getenv(u1 *name);
foreign c s4 setenv(u1 *name, u1 *value, s4 overwrite);
foreign c s4 unsetenv(u1 *name);
foreign c s4 * __errno_location(void);

// Returns a borrowed environment value; do not free or modify it. The pointer
// may be invalidated by a later env_set/env_unset call.
u1, u1 *env_get(u1 *name) {
    u1 *value = 0;
    u1 *null_pointer = 0;

    if (name == null_pointer || name[0] == 0) {
        return 0, null_pointer;
    }
    value = getenv(name);
    if (value == null_pointer) {
        return 0, null_pointer;
    }
    return 1, value;
}

s8 env_set(u1 *name, u1 *value, u1 overwrite) {
    u1 *null_pointer = 0;

    if (name == null_pointer || name[0] == 0 || value == null_pointer) {
        return -22;
    }
    if (setenv(name, value, overwrite != 0) < 0) {
        return -*__errno_location();
    }
    return 0;
}

s8 env_unset(u1 *name) {
    u1 *null_pointer = 0;

    if (name == null_pointer || name[0] == 0) {
        return -22;
    }
    if (unsetenv(name) < 0) {
        return -*__errno_location();
    }
    return 0;
}
