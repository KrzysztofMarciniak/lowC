// Writes a NUL-terminated path into the caller-owned buffer; capacity includes
// the terminator. Returns 0 or a negative Linux error code.
s8 working_directory_get(u1 *buffer, u8 capacity) {
    u1 *null_buffer = 0;

    if (buffer == null_buffer) {
        return -22;
    }
    if (capacity == 0) {
        return -22;
    }
    return __lowc_os_getcwd(buffer, capacity);
}

s8 working_directory_set(u1 *path) {
    u1 *null_path = 0;

    if (path == null_path) {
        return -22;
    }
