void __lowc_print_u8(u8 value) {
        u1 digits[20]  = 0;
        u8 index       = 0;
        u8 quotient    = 0;
        u8 remainder   = 0;

        index = 20;

        if (value == 0) {
                index         = 19;
                digits[index] = 48;
        }

        for (; value != 0;) {
                asm("xor rdx, rdx\ndiv rsi\nmov [rdi], rdx"
                    : "=rax"(quotient)
                    : "rax"(value), "rsi"(10), "rdi"(&remainder)
                    : "rdx", "memory", "cc");

