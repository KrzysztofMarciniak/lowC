void __lowc_write_stdout(u8 *data, u64 length) {
    for (; length != 0; ) {
        s64 written;

        asm("syscall"
            : "=rax"(written)
            : "rax"(1), "rdi"(1), "rsi"(data), "rdx"(length)
            : "rcx", "r11", "memory", "cc");

        if (written <= 0) {
            return;
        }

        data = data + written;
        length = length - written;
    }

    return;
}
