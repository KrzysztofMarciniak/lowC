void __lowc_write_stdout(u1* data, u8 length) {
        for (; length != 0;) {
                s8 written = 0;

                asm("syscall"
                    : "=rax"(written)
                    : "rax"(1), "rdi"(1), "rsi"(data), "rdx"(length)
                    : "rcx", "r11", "memory", "cc");

                if (written <= 0) {
                        return;
                }

                data   = data + written;
                length = length - written;
        }

        return;
}

void __lowc_print_u1(u1 value) {
        u1 digits[3]   = 0;
        u8 index       = 0;
        u8 quotient    = 0;
        u8 remainder   = 0;

        index = 3;

        if (value == 0) {
                index         = 2;
                digits[index] = 48;
        }

        for (; value != 0;) {
                asm("xor rdx, rdx\ndiv rsi\nmov [rdi], rdx"
                    : "=rax"(quotient)
                    : "rax"(value), "rsi"(10), "rdi"(&remainder)
                    : "rdx", "memory", "cc");

                index         = index - 1;
                digits[index] = 48 + remainder;
                value         = quotient;
        }

        __lowc_write_stdout(&digits[index], 3 - index);
        return;
}

