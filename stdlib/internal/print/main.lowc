void __lowc_print_s1(s1 value) {
        u1 digits[4]   = 0;
        u1 magnitude   = 0;
        u1 negative    = 0;
        u8 index       = 0;
        u8 quotient    = 0;
        u8 remainder   = 0;

        if (value < 0) {
                negative = 1;
                asm("neg rax" : "=rax"(magnitude) : "rax"(value) : "cc");
        } else {
                magnitude = value;
        }

        index = 4;

        if (magnitude == 0) {
                index         = 3;
                digits[index] = 48;
        }

        for (; magnitude != 0;) {
                asm("xor rdx, rdx\ndiv rsi\nmov [rdi], rdx"
                    : "=rax"(quotient)
                    : "rax"(magnitude), "rsi"(10), "rdi"(&remainder)
                    : "rdx", "memory", "cc");

                index         = index - 1;
                digits[index] = 48 + remainder;
                magnitude     = quotient;
        }

        if (negative != 0) {
                index         = index - 1;
                digits[index] = 45;
        }

        __lowc_write_stdout(&digits[index], 4 - index);
        return;
}

