u8 inline_assembly_move(void) {
    u8 result;
    asm("mov %0, %1" : "=rax"(result) : "rdi"(42) : );
    return result;
}

u8 inline_assembly_syscall_pid(void) {
    u8 result;
    asm("syscall" : "=rax"(result) : "rax"(39) : "rcx", "r11");
    return result;
}

u8 inline_assembly_callee_saved(void) {
    u8 result;
    asm("mov %0, 17" : "=rbx"(result) : :);
    return result;
}

u8 inline_assembly_call_target(void) {
    return 23;
}

u8 inline_assembly_call(void) {
    u8 result;
    asm(
        "call inline_assembly_call_target\nmov %0, rax"
        : "=rax"(result)
        : :
            "rcx", "rdx", "rsi", "rdi",
            "r8", "r9", "r10", "r11"
    );
    return result;
}
