#include "/usr/local/share/lowc/public/http.lowc" :
    "HttpResponse", "http_get";
#include "/usr/local/share/lowc/public/file.lowc" :
    "File", "file_open_write", "file_write", "file_close";
#include "/usr/local/share/lowc/public/print.lowc" :
    "print", "print_s8";

s8 download_to_file(void) {
    struct HttpResponse response = 0;
    struct File output = 0;
    u1 body[65536] = 0;
    s8 body_length = 0;
    s8 result = 0;
    u8 written = 0;

    body_length = http_get(
        "192.168.1.224",
        8000,
        "/",
        &body[0],
        65536,
        &response
    );
    if (body_length < 0) {
        return body_length;
    }

    result = file_open_write("response.html", &output);
    if (result != 0) {
        return result;
    }

    for (; written < body_length;) {
        result = file_write(
            &output,
            &body[written],
            body_length - written
        );
        if (result <= 0) {
            file_close(&output);
            if (result < 0) {
                return result;
            }
            return -20006;
        }
        written = written + result;
    }

    result = file_close(&output);
    if (result != 0) {
        return result;
    }

    return response.status_code;
}

void entrypoint(void) {
    s8 result = download_to_file();

    if (result == 200) {
        print("Saved response.html\n");
    } else if (result > 0) {
        print("Saved response; HTTP status ");
        print_s8(result);
        print("\n");
    } else {
        print("GET or file error: ");
        print_s8(result);
        print("\n");
    }

    return;
}
