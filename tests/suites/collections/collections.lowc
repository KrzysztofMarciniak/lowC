        if (vector_u1_push(&vector, 73) != 0) return 102;
        if (vector_u1_push(&vector, 74) != 0) return 103;
        if (vector_u1_get(&vector, 0, &value) != 0) return 104;
        if (value != 73) return 105;
        if (vector_u1_set(&vector, 1, 73) != 0 ||
            vector_u1_get(&vector, 1, &value) != 0 || value != 73 ||
            vector_u1_remove(&vector, 0, &value) != 0 || value != 73 ||
            vector_u1_get(&vector, 1, &value) != -34 ||
            vector_u1_deinit(&vector) != 0) {
                return 20;
        }

        if (list_u1_init(&list) != 0 ||
