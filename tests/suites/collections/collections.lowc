            list_u1_append(&list, 74) != 0 ||
            list_u1_get(&list, 1, &value) != 0 || value != 74 ||
            list_u1_remove(&list, 0, &value) != 0 || value != 73 ||
            list_u1_get(&list, 0, &value) != 0 || value != 74 ||
            list_u1_append(&list, 73) != 0 ||
            list_u1_get(&list, 1, &value) != 0 || value != 73 ||
            list_u1_remove(&list, 1, &value) != 0 || value != 73 ||
            list_u1_deinit(&list) != 0 || list.size != 0 ||
            list_u1_deinit(&list) != 0) {
                return 30;
        }

        if (set_u1_init(&set, 0) != 0 ||
            set_u1_add(&set, 73) != 1 ||
            set_u1_add(&set, 74) != 1 ||
            set_u1_add(&set, 73) != 0 ||
            set_u1_contains(&set, 74, &contains) != 0 || contains != 1 ||
            set_u1_remove(&set, 73) != 1 ||
            set_u1_remove(&set, 73) != 0 ||
            set_u1_contains(&set, 73, &contains) != 0 || contains != 0 ||
            set_u1_deinit(&set) != 0) {
                return 40;
        }
        return 0;
}

