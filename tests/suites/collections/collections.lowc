        if (result != 0) return result;
        result = test_s4();
        if (result != 0) return result;
        result = test_s8();
        if (result != 0) return result;

        struct VectorU1 overflow = 0;
        struct SetU1 set_overflow = 0;
        if (vector_u1_init(&overflow, 9223372036854775807) != -75) {
                return 20;
        }
        if (set_u1_init(&set_overflow, 9223372036854775807) != -75) {
