struct Point {
    s8 x;
    s8 y;
};

s8 add(s8 a, s8 b) {
    return a + b;
}

void process(void) {
    s8 values[5] = 0;
    s8 *ptr = 0;
    struct Point point = 0;

    values[0] = 10;
    values[1] = 20;
    ptr = &values[0];

    *ptr = *ptr + 5;

    point.x = values[0];
    point.y = values[1];

    if (point.x < point.y && point.y != 0) {
        point.x = add(point.x, point.y);
    } else {
        point.x = point.x - 1;
    }

    for (s8 i = 0; i < 5; i = i + 1) {
        values[i] = values[i] + 1;
    }

    return;
}

void entrypoint(void) {
    process();
    return;
}
