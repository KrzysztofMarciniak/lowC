void test_unsigned(void) {
    u1 a = 1;
    u2 b = 2;
    u4 c = 4;
    u8 d = 8;
    return;
}

void test_signed(void) {
    s1 a = 1;
    s2 b = 2;
    s4 c = 4;
    s8 d = 8;
    return;
}

u8 test_widths(void) {
    u1 bytes[2] = 0;
    u2 words[2] = 0;
    u4 double_words[2] = 0;
    u8 quad_words[2] = 0;

    bytes[1] = 1;
    words[1] = 2;
    double_words[1] = 4;
    quad_words[1] = 8;

    return bytes[1] + words[1] + double_words[1] + quad_words[1];
}
