#include "visibility_dependency.lowc" : "dependency_value";

struct Exported {
    s8 value;
};

struct PrivateType {
    s8 value;
};

s8 exported_global = 10;
s8 private_global = 20;

s8 private_function(void) {
    return private_global + dependency_value();
}

s8 exported_function(void) {
    return private_function() + exported_global;
}
