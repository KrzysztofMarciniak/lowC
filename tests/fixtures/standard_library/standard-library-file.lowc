#include "@PUBLIC_ROOT@/file.lowc" :
    "File", "file_open_read", "file_open_write", "file_open_append",
    "file_read", "file_write", "file_close";
#include "@PUBLIC_ROOT@/string.lowc" : "strcmp";

u8 standard_library_file_test(u1 *path) {
    struct File file = 0;
    u1 buffer[16] = 0;
    s8 result = 0;

    if (file_open_write(path, &file) != 0) {
        return 1;
    }
    if (file_write(&file, "hello", 5) != 5 || file_close(&file) != 0) {
        return 2;
    }

    if (file_open_append(path, &file) != 0) {
        return 3;
    }
    if (file_write(&file, "!", 1) != 1 || file_close(&file) != 0) {
        return 4;
    }

    if (file_open_read(path, &file) != 0) {
        return 5;
    }
    result = file_read(&file, &buffer[0], 15);
    if (result != 6) {
        return 6;
    }
    buffer[result] = 0;
    if (
        strcmp(&buffer[0], "hello!") != 0 ||
        file_read(&file, &buffer[0], 1) != 0
    ) {
        return 7;
    }
    if (file_close(&file) != 0 || file_close(&file) != -9) {
        return 8;
    }
    if (file_open_read("/lowc-path-that-does-not-exist/file", &file) >= 0) {
        file_close(&file);
        return 9;
    }

    return 0;
}
