#include "@PUBLIC_ROOT@/args.lowc" :
    "args_count", "args_get";
#include "@PUBLIC_ROOT@/print.lowc" :
    "print", "print_u8";

void entrypoint(void) {
    u8 count = 0;
    u1 *argument = 0;
    u1 found = 0;

    count = args_count();
    print_u8(count);
    print("|");

    (found, argument) = args_get(0);
    if (found) {
        print(argument);
    } else {
        print("missing");
    }
    print("|");

    (found, argument) = args_get(1);
    if (found) {
        print(argument);
    } else {
        print("missing");
    }
    print("|");

    (found, argument) = args_get(2);
    if (found) {
        print(argument);
    } else {
        print("missing");
    }
    print("|");

    (found, argument) = args_get(count);
    if (found) {
        print("unexpected");
    } else {
        print("missing");
    }
    print("\n");
    return;
}
